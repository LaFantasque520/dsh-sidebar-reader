{
  "name": "dsh-sidebar-operator",
  "description": "Read the current session's sidebar and drive its terminals: tabs, terminal screens, browser text, plus list/open/write/close with sandbox-aligned approval.",
  "version": "2.0.0",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "author": "LaFantasque520",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LaFantasque520/dsh-sidebar-reader.git"
  },
  "homepage": "https://github.com/LaFantasque520/dsh-sidebar-reader#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "sidebar",
    "terminal",
    "operator"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-api-gateway"],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.2.1-rc.2 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
