{
  "name": "dsh-terminal-operator",
  "description": "Let the model drive the sidebar terminal: list, open, write text into a terminal and close it, returning the resulting screen.",
  "version": "0.2.0",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "author": "local",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "terminal",
    "sidebar",
    "operator"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-api-gateway"],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.2.1-rc.2 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
